logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(reading-garden|pawtogether)-prod-.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.containers.output
  forward_to       = [loki.process.docker.receiver]
  refresh_interval = "10s"
}

loki.process "docker" {
  stage.static_labels {
    values = {
      source = "docker",
      host   = "oracle-a1",
    }
  }

  forward_to = [loki.relabel.app_containers.receiver]
}

loki.relabel "app_containers" {
  forward_to = [loki.write.local.receiver]

  rule {
    source_labels = ["container"]
    regex         = "(reading-garden|pawtogether)-prod-.*"
    action        = "keep"
  }
  rule {
    source_labels = ["container"]
    regex         = "reading-garden-prod-.*"
    target_label  = "service"
    replacement   = "reading-garden-kotlin"
  }

  rule {
    source_labels = ["container"]
    regex         = "pawtogether-prod-.*"
    target_label  = "service"
    replacement   = "pawtogether"
  }

  rule {
    target_label = "env"
    replacement  = "prod"
  }

}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

local.file_match "caddy_access" {
  path_targets = [
    {
      __address__ = "localhost",
      __path__ = "/var/log/caddy/reading-garden-prod-access.log",
      env = "prod",
      host = "oracle-a1",
      service = "caddy",
      source = "caddy_access",
    },
    {
      __address__ = "localhost",
      __path__ = "/var/log/caddy/pawtogether-prod-access.log",
      env = "prod",
      host = "oracle-a1",
      service = "caddy",
      source = "caddy_access",
    },
  ]
}

loki.source.file "caddy_access" {
  targets    = local.file_match.caddy_access.targets
  // File positions include source labels; enrich only after reading.
  forward_to = [loki.relabel.caddy_access.receiver]
}

loki.relabel "caddy_access" {
  forward_to = [loki.write.local.receiver]

  rule {
    source_labels = ["filename"]
    regex         = "/var/log/caddy/reading-garden-prod-access\\.log"
    target_label  = "service"
    replacement   = "reading-garden-kotlin"
  }

  rule {
    source_labels = ["filename"]
    regex         = "/var/log/caddy/pawtogether-prod-access\\.log"
    target_label  = "service"
    replacement   = "pawtogether"
  }

  rule {
    target_label = "component"
    replacement  = "caddy"
  }
}

loki.source.journal "caddy" {
  matches       = "SYSLOG_IDENTIFIER=caddy"
  path          = "/var/log/journal"
  max_age       = "2h"
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    source  = "journal",
    host    = "oracle-a1",
    service = "caddy",
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "apps" {
  http {
    endpoint = sys.env("OTLP_HTTP_LISTEN_ADDRESS")
  }
  output {
    traces = [otelcol.processor.memory_limiter.traces.input]
  }
}

otelcol.processor.memory_limiter "traces" {
  check_interval = "1s"
  limit = "512MiB"
  output {
    traces = [otelcol.processor.transform.trace_privacy.input]
  }
}

otelcol.processor.transform "trace_privacy" {
  error_mode = "propagate"
  trace_statements {
    context = "span"
    statements = [
      `delete_key(attributes, "url.query")`,
      `delete_key(attributes, "url.full")`,
      `delete_key(attributes, "http.url")`,
      `delete_key(attributes, "http.target")`,
      `delete_key(attributes, "db.statement")`,
      `delete_key(attributes, "db.query.text")`,
    ]
  }
  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  timeout = "5s"
  send_batch_size = 512
  send_batch_max_size = 1024
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "127.0.0.1:14317"
    tls {
      insecure = true
    }
  }
}
